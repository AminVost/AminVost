# Optional. Leave empty until the GA4 web stream is created.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional URL-prefix Search Console verification meta token.
# For aminvost.ir, a Domain Property verified by DNS is preferred and does not need this.
GOOGLE_SITE_VERIFICATION=

# AI Resume Assistant — server-only Gemini key pool.
# Recommended on Vercel: one JSON array. Each projectId represents one shared
# Google quota bucket. Use the real RPM/TPM/RPD values shown for your model/tier.
# Keep this on one line in Vercel and never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY_POOL=[{"key":"YOUR_KEY_1","projectId":"google-project-1","priority":1,"rpm":0,"tpm":0,"rpd":0},{"key":"YOUR_KEY_2","projectId":"google-project-2","priority":2,"rpm":0,"tpm":0,"rpd":0}]

# Optional simpler format for separate Google projects. Limits below apply to
# every key. JSON above is preferred when limits differ between projects.
GOOGLE_GENERATIVE_AI_API_KEYS=
GEMINI_RPM_LIMIT=
GEMINI_TPM_LIMIT=
GEMINI_RPD_LIMIT=

# Backwards-compatible single-key fallback.
GOOGLE_GENERATIVE_AI_API_KEY=

# Use a random 32+ character value. Example generation:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AI_CHAT_SESSION_SECRET=

# Cloudflare Turnstile is optional for the initial release.
# Keep this false to run the AI assistant without Turnstile. Enable it later without code changes.
NEXT_PUBLIC_AI_TURNSTILE_ENABLED=false
# Required only when NEXT_PUBLIC_AI_TURNSTILE_ENABLED=true.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Strongly recommended distributed protection on Vercel.
# Create three @vercel/firewall rate-limit rules so each flow has its own quota.
VERCEL_FIREWALL_CHAT_RATE_LIMIT_ID=
VERCEL_FIREWALL_SESSION_RATE_LIMIT_ID=
VERCEL_FIREWALL_CONTACT_RATE_LIMIT_ID=

# Optional backwards-compatible fallback if you prefer one shared WAF rule.
VERCEL_FIREWALL_RATE_LIMIT_ID=

# Telegram lead notification (recommended).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email notification through Resend. Leave empty to use Telegram only.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
